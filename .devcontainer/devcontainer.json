{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Gemini Video Watermark Cleaner",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Gemini Video Watermark Cleaner",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postCreateCommand": "npm install --no-audit --no-fund && npm run setup:alpha",
  "postStartCommand": "bash .devcontainer/start-vite.sh",
  "remoteUser": "node"
}
